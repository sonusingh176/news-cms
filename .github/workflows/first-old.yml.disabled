# **Why This Workflow Is Disabled**

# In the previous workflow, the `build` step was used only for demonstration purposes.
# The build generated in GitHub Actions was not used for deployment.

# Instead, the workflow sent the repository code to Vercel, where Vercel handled
# the build process and deployed the application using its own build.

# Since the GitHub Actions build was not used in the actual deployment,
#  we are keeping the old workflow for reference but disabling it to avoid unnecessary workflow runs.
#   The file has been renamed to `ci-old.yml.disabled`.

# GitHub Actions recognizes workflow files with `.yml` or `.yaml` extensions inside `.github/workflows/`.
# Because this file now has a `.disabled` extension, GitHub Actions will not recognize or execute it as a workflow.
# The code remains available for future reference.

name: News CMS First Workflow
on: push

jobs:
    validate-files:
        runs-on: ubuntu-latest
        steps:
            - name: Get repository code
              uses: actions/checkout@v4

            # - name: Check project files
            #   run: |
            #         pwd
            #         ls -la
            #         git ls-files package-lock.json

            - name: Set up Node.js
              uses: actions/setup-node@v4
              with:
                node-version: 24

            - name: Validate HTML file
              run: test -f index.html

            - name: Validate React entry file
              run: test -f src/main.jsx

            - name: Validate App component
              run: test -f src/App.jsx

            - name: Validate package file
              run: test -f package.json
    
    lint:
        runs-on: ubuntu-latest
        # needs:  validate-files

        steps:
            - name: Get repository code
              uses: actions/checkout@v4

            - name: Set up Node.js
              uses: actions/setup-node@v4
              with:
                node-version: 24
                cache: npm

            - name: Install dependencies
              run: npm ci

            - name: Run ESLint
              run: npm run lint

    # Builds the production version after validation and linting succeed.
    build:
        runs-on: ubuntu-latest
        needs: [validate-files,lint]

        steps:
            # Downloads the repository code.
            - name: Get repository code
              uses: actions/checkout@v4

            # Sets up Node.js for the production build.
            - name: Set up Node.js
              uses: actions/setup-node@v4
              with:
                node-version: 24
                cache: npm

            # Installs dependencies required for building the project.
            - name: Install dependencies
              run: npm ci

            # Creates the production-ready files in the dist/ directory.
            - name: Build project
              run: npm run build
            
            # Uploads the generated dist/ files so they can be downloaded.
            - name: Upload product build
              uses: actions/upload-artifact@v4
              with:
                path: dist/
                # Fails if no build files are found.
                if-no-files-found: error
                # Duration after which the artifact expires, in days.
                # Minimum: 1 day. Maximum: 90 days (subject to repository settings).
                # The value 0 uses the default retention period.
                retention-days: 7
    
    # Deploys the project to Vercel after validation, linting, and build succeed.
    deploy:
        needs: [validate-files,lint,build]
        runs-on: ubuntu-latest

        steps:
            # Downloads the repository code to the runner.
            - name: Checkout repository
              uses: actions/checkout@v4 

            # Installs the Vercel command-line tool globally.
            - name: Install Vercel CLI
              run: npm install --global vercel

            # Deploys the project to Vercel using the production environment.
            # VERCEL_TOKEN must be configured in GitHub repository secrets.
            - name: Deploy to Vercel
              run: vercel --prod --yes --token="${{secrets.VERCEL_TOKEN}}"
